# ---------------------------------------------------------------------------
# Studio CMS (/admin)
#
# Copy to .env.local for local work, and add the same values in Netlify under
# Site configuration → Environment variables. Everything here is server-only
# except the NEXT_PUBLIC_ entries. Never prefix a secret with NEXT_PUBLIC.
# ---------------------------------------------------------------------------

# CMS sign-in (/admin).
# CMS_PASSWORD defaults to "admin" if unset. Set a real one before launch,
# because this login can commit to your repo and upload to your Cloudinary.
CMS_PASSWORD=
# Any long random string. Signs the login cookie; changing it logs everyone out.
CMS_SESSION_SECRET=

# Cloudinary: Dashboard → API Keys.
# The cloud name is already public in the image URLs; the key and secret are not.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=duuqhl0w9
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GitHub: used to commit content/*.json when you press Publish.
# Create a fine-grained personal access token scoped to THIS repository only,
# with Contents: Read and write. No other permission is needed.
GITHUB_TOKEN=
GITHUB_REPO=owner/repository-name
GITHUB_BRANCH=main

# Netlify sets URL automatically on deploy. Only needed locally, so the server
# knows where to validate Identity logins against.
# NEXT_PUBLIC_SITE_URL=https://kanchanmarblearts.com

# Existing analytics
NEXT_PUBLIC_GA_ID=
